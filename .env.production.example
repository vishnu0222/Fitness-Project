POSTGRES_USER=fitness
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=fitness

RABBITMQ_DEFAULT_USER=fitness
RABBITMQ_DEFAULT_PASS=change_this_rabbitmq_password
RABBITMQ_EXCHANGE=fitness.events
RABBITMQ_PREFETCH=5

DATABASE_URL=postgresql://fitness:change_this_postgres_password@postgres:5432/fitness?schema=public
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=60
RABBITMQ_URL=amqp://fitness:change_this_rabbitmq_password@rabbitmq:5672

PORT=3000
JWT_SECRET=change_this_jwt_secret
OPENAI_API_KEY=change_this_openai_api_key
OPENAI_MODEL=o4-mini

OUTBOX_POLL_MS=3000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_RETRIES=10
OUTBOX_RETRY_BASE_MS=2000

SMTP_HOST=smtp.example.com
SMTP_USER=change_this_smtp_user
SMTP_PASS=change_this_smtp_password
MAIL_FROM=Fitness Platform <no-reply@example.com>
